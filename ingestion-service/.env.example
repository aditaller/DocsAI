# Copy to .env. Connection strings are local secrets; never commit the real file.
SQLSERVER_CONNECTION_STRING=<SQL Server connection string for a read-only archive account>
POSTGRES_CONNECTION_STRING=<PostgreSQL connection string for the RAG writer account>

# Identifiers are validated at runtime and values are passed as query parameters.
# `claimIdColumn` must resolve to the numeric source claim identity that should map
# to the existing numeric rag.claim.id. `contentColumn` can be null only when the worker can
# read fullPathColumn under ARCHIVE_FILE_ROOT. Use a binary varbinary column whenever
# one is available.
ARCHIVE_MAPPING_JSON={"version":"taldar-archive-v1","schema":"gnr","relation":"v_archive","idColumn":"archiveid","claimIdColumn":"objectid","fileNameColumn":"filename","mimeTypeColumn":null,"contentColumn":null,"fullPathColumn":"fullpath","modifiedAtColumn":"modifieddate"}
ARCHIVE_FILE_ROOT=C:\TaldarArchive

# Required audit/write user for rag.document / rag.documentchunk / rag.ingestionrun.
# Use an existing application user ID from the local rag database.
RAG_WRITE_USER_ID=<existing rag application user id>

# The RAG writer uses the inspected base names and validates them at runtime:
# document(id, createuserid, claimid, filename, originalfilename, mimetype,
# sizebytes, sha256, storagepath); documentchunk(id, createuserid,
# ingestionrunid, documentid, claimid, parsercode, chunkindex, tokencount,
# charcount, contenttext, contentembedding); ingestionrun(id, createuserid,
# documentid, claimid, parsercode, embeddingmodel, embeddingdims, statuscode).
# `claimIdColumn` is therefore the local rag.claim.id; every source claim ID
# must already exist in rag.claim before it can be ingested.

# The worker refuses non-loopback Ollama endpoints.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_OCR_MODEL=qwen3.6:35b-a3b
# Backs the separate `deepseek-ocr` engine id, so both vision models are
# selectable at once and can be compared on the same scan. DeepSeek-OCR follows
# only its own fixed prompts — the client picks that prompt off the model name,
# so a `deepseek-ocr:*` tag must keep that prefix.
OLLAMA_DEEPSEEK_OCR_MODEL=deepseek-ocr:latest
# Must emit EMBEDDING_DIMENSIONS dims, natively or by Matryoshka truncation.
# qwen3-embedding:0.6b is natively 1024 and only 2.37 GB resident, which leaves
# room for the chat model to stay loaded alongside it on a 16 GB card.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Required only by `npm run serve` (the HTTP surface the Angular app calls).
# The batch CLI never completes text and runs without it.
# Small models refuse rather than reason over noisy OCR: pick one with room to
# map a question onto what a document actually says.
OLLAMA_CHAT_MODEL=gpt-oss:20b
# Obtain this from `ollama show qwen3-embedding:4b` / a local probe; do not guess it.
# It must equal the width of rag.documentchunk.contentembedding, which is shared
# with the other parsers' partial indexes. Matryoshka models honour a shorter
# request, so a 2560-dim model can serve a vector(1024) column.
EMBEDDING_DIMENSIONS=<verified embedding vector dimension>

# Raised for the retrieval prompt, which carries several chunks and would overrun
# Ollama's 4096 default, and for the vision OCR call, which otherwise spends the
# whole budget on reasoning and returns an empty transcription.
OLLAMA_NUM_CTX=16384

# How long Ollama keeps a model in VRAM after a call. The chat drawer embeds the
# question and then completes it, so a value short enough to unload between those
# two makes every question pay a multi-second reload. Ollama duration strings;
# `-1` never unloads.
OLLAMA_KEEP_ALIVE=1h

# Which engine reads the pages: tesseract-auto, tesseract-heb, tesseract-eng,
# or ollama. tesseract-auto reads the script off page 1 with tesseract's own OSD
# mode (one extra ~0.5s exec per scanned document) and loads the matching set;
# name a set explicitly when OSD cannot call the scan and you know the corpus.
# The tesseract engines run through the container below and are roughly an order
# of magnitude faster than the vision model; they are also the only ones that read
# Hebrew reliably. `ollama` keeps the vision model, which handles handwriting and
# unusual layouts better.
# The HTTP server lets each request override this with ?engine=; the batch CLI
# runs whatever is set here.
LOCAL_OCR_ENGINE=tesseract-auto
# Reached with `docker exec -i`, so the container needs no published port and no
# mount — it only has to be running with tesseract on its PATH.
TESSERACT_CONTAINER=tesseract-ocr
# Languages per engine. The first is the primary one, and every language listed
# must be installed in the container: check with
# `docker exec tesseract-ocr tesseract --list-langs`. `osd` must be installed
# too — it is what tesseract-auto detects the script with.
# Keep `eng` in the Hebrew set — without it, dates, amounts and reference numbers
# come back as noise, because the Hebrew model has no Latin digit shapes.
TESSERACT_LANGS_HEB=heb+eng
# Leave `heb` out of the English set: loading it makes an English page worse, as
# the Hebrew model competes for every Latin glyph.
TESSERACT_LANGS_ENG=eng

# Azure Document Intelligence's Layout model, run as a local container. This is
# the only engine that reports which checkbox was ticked, which is what a scanned
# questionnaire's answers actually are — every other engine returns the questions
# and silently drops the answers.
#
# The container reads the document on this host; only page counts go to the Azure
# resource named by its `billing` argument. It is held to the same loopback rule
# as Ollama so the document itself can never be sent across a network to reach it.
# Start it with (needs an Azure Document Intelligence resource for billing only):
#   docker run -d --name azure-di-layout -p 5000:5000 --cpus 8 --memory 16g \
#     mcr.microsoft.com/azure-cognitive-services/form-recognizer/layout-4.0 \
#     EULA=accept billing=<endpoint-uri> apiKey=<key>
AZURE_LAYOUT_URL=http://127.0.0.1:5000

# pdftoppm (Poppler) or a compatible Ghostscript wrapper must be installed locally.
# On Windows: winget install --id oschwartz10612.Poppler -e
# Prefer the absolute path — a running server never sees a PATH change. pdftotext
# is read from the same directory, so this one setting covers both: a digital PDF
# is lifted from its text layer and never rendered or OCR'd at all.
PDFTOPPM_PATH=pdftoppm
MAX_SOURCE_BYTES=52428800
MAX_PAGES=100
PDF_RENDER_TIMEOUT_MS=120000
# Render resolution for PDF pages. 150 is poppler's default and what the vision
# model was tuned against; 300 suits tesseract, which reads small Hebrew type far
# better at that size — and gives OSD enough to call the script confidently
# rather than declining. The vision model pays for the extra pixels in image
# tokens, so this is a per-deployment trade rather than a fixed value.
PDF_RENDER_DPI=300
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=200
MAX_ATTEMPTS=4
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000
LOG_LEVEL=info

# HTTP surface for the Angular "Use Local RAG" mode. Binds to 127.0.0.1 only —
# it performs no authentication, so it must never listen on a public interface.
# Must match the /api/local target in the app's proxy.conf.json.
LOCAL_API_PORT=11500
# Chunks retrieved per question and sent to the chat model.
RAG_TOP_K=8
