# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output — unanchored so ingestion-service/dist is covered too, now
# that this repository spans the whole project and not just src/.
dist/
/tmp
out-tsc/
/bazel-out

# Node
node_modules/
npm-debug.log
yarn-error.log

# Secrets. .env holds live database credentials; .env.example is the template
# and is meant to be committed.
.env
!.env.example

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
.angular/
.playwright-mcp/
.claude/settings.local.json
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
